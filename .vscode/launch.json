{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Benchmark: Full Run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Benchmark: Quick Mode",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "args": ["--quick"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
